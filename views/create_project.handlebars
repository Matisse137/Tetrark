<div class="container mt-5">
    <h2>Gestion du Projet</h2>

    <form action="/modules/projects/create" method="POST" class="mt-4">
        <div class="form-group mb-3">
            <label for="title">Titre du projet</label>
            <input type="text" name="title" id="title" class="form-control" required>
        </div>

        <div class="row">
            <div class="col-md-6 form-group mb-3">
                <label for="category">Catégorie</label>
                <select name="category" id="category" class="form-control">
                    <option value="Idée">Idée</option>
                    <option value="En cours">En cours</option>
                    <option value="Terminé">Terminé</option>
                    <option value="En pause">En pause</option>
                    <option value="Abandonné">Abandonné</option>
                </select>
            </div>
            <div class="col-md-6 form-group mb-3">
                <label for="is_public">Visibilité SEO</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="is_public" id="is_public" checked>
                    <label class="form-check-label" for="is_public">Public (Indexé)</label>
                </div>
            </div>
        </div>

        <div class="form-group mb-3">
            <label for="github_repo">Dépôt GitHub (Optionnel)</label>
            <input type="text" name="github_repo" id="github_repo" class="form-control" placeholder="ex: Matisse137/Tetrark">
            <small class="text-muted">Laissez vide si le projet n'est pas sur GitHub.</small>
        </div>

        <div class="form-group mb-3">
            <label for="description">Description courte (SEO)</label>
            <input type="text" name="description" id="description" class="form-control" maxlength="160">
        </div>

        <div class="form-group mb-3">
            <label for="content">Contenu (Format Markdown)</label>
            <textarea name="content" id="content" class="form-control" rows="15" placeholder="# Introduction..."></textarea>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-success">Enregistrer le projet</button>
        </div>
    </form>
</div>