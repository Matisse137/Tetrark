<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/modules/projects">Projets</a></li>
            <li class="breadcrumb-item active">{{project.title}}</li>
        </ol>
    </nav>

    <article class="project-content mt-4">
        <header class="mb-5 border-bottom pb-3">
            <h1 class="display-4">{{project.title}}</h1>
            <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-info text-dark">{{project.category}}</span>
                <small class="text-muted">Mis à jour le : {{project.updatedAt}}</small>
            </div>
        </header>

        <div class="markdown-body">
            {{{project.html_content}}}
        </div>

        {{#if project.versions.length}}
            <section class="mt-5 pt-4 border-top">
                <h3>Historique des versions (Monitoring)</h3>
                <ul class="list-group list-group-flush">
                    {{#each project.versions}}
                        <li class="list-group-item">
                            <strong>{{this.number}}</strong> <small>({{this.date}})</small>
                            <p class="mb-0">{{this.changelog}}</p>
                        </li>
                    {{/each}}
                </ul>
            </section>
        {{/if}}
    </article>
</div>