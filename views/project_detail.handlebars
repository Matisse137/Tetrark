<div class="container mt-5">
    <header class="project-header border-bottom pb-4 mb-4">
        <h1 class="display-4">{{project.title}}</h1>

        <div class="d-flex align-items-center gap-3 mt-2">
            <span class="badge bg-primary">{{project.category}}</span>

            {{#if project.github_repo}}
                <span class="badge bg-dark border border-success text-success">
                    Dernière Release: {{github.tag}}
                </span>

                <form action="https://github.com/{{project.github_repo}}/tree/" method="GET" class="d-flex align-items-center gap-2">
                    <select onchange="if(this.value) window.location.href='https://github.com/{{project.github_repo}}/tree/' + this.value" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Accéder aux branches...</option>
                        {{#each github.branches}}
                            <option value="{{this.name}}">{{this.name}}</option>
                        {{/each}}
                    </select>
                </form>
            {{/if}}
        </div>
    </header>

    <div class="markdown-body mb-5">
        {{{rendered_html}}}
    </div>

    {{#if project.versions.length}}
        <section class="monitoring-section mt-5 pt-4 border-top">
            <h3 class="mb-4">Suivi des versions</h3>
            {{#each project.versions}}
                <div class="version-card mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="version-number">{{this.number}}</span>
                        <small class="text-muted">{{this.date}}</small>
                    </div>
                    <p class="mt-2 mb-0">{{this.changelog}}</p>
                </div>
            {{/each}}
        </section>
    {{/if}}
</div>